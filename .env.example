# ============================================
# TulaPramaan - 3-Stage Smart Form System
# Environment Configuration
# ============================================

# ============================================
# Application Settings
# ============================================
APP_NAME=TulaPramaan
APP_VERSION=1.0.0
APP_ENV=development  # development | staging | production
DEBUG=true

# Server Configuration
HOST=0.0.0.0
PORT=8000
API_PREFIX=/api/v1

# ============================================
# API Endpoints Configuration
# ============================================
# Base URL for API (used by frontend)
API_BASE_URL=http://localhost:8000/api/v1

# Classification Endpoints
CLASSIFICATION_DETERMINE_ENDPOINT=/api/v1/classification/determine
CLASSIFICATION_CONFIRM_ENDPOINT=/api/v1/classification/confirm
CLASSIFICATION_SUGGEST_MIN_ENDPOINT=/api/v1/classification/suggest-min/{e}/{class}
CLASSIFICATION_HISTORY_ENDPOINT=/api/v1/classification/history/{instrument_profile_id}

# Test Plan Endpoints
TEST_PLAN_ASSEMBLE_ENDPOINT=/api/v1/test-plans/assemble
TEST_PLAN_GET_ENDPOINT=/api/v1/test-plans/{test_job_id}
TEST_PLAN_SUMMARY_ENDPOINT=/api/v1/test-plans/{test_job_id}/summary

# Environment Endpoints
ENVIRONMENT_SESSION_ENDPOINT=/api/v1/environment/session
ENVIRONMENT_SESSION_GET_ENDPOINT=/api/v1/environment/session/{test_job_id}
ENVIRONMENT_READING_OVERRIDE_ENDPOINT=/api/v1/environment/reading/override
ENVIRONMENT_READINGS_GET_ENDPOINT=/api/v1/environment/readings/{test_run_id}
ENVIRONMENT_SUMMARY_ENDPOINT=/api/v1/environment/summary/{test_job_id}

# Instrument Profile Endpoints (to be implemented)
INSTRUMENT_PROFILE_CREATE_ENDPOINT=/api/v1/instruments
INSTRUMENT_PROFILE_GET_ENDPOINT=/api/v1/instruments/{id}
INSTRUMENT_PROFILE_UPDATE_ENDPOINT=/api/v1/instruments/{id}
INSTRUMENT_PROFILE_LIST_ENDPOINT=/api/v1/instruments

# Health & Status Endpoints
HEALTH_ENDPOINT=/health
STATUS_ENDPOINT=/api/v1/status
ROOT_ENDPOINT=/

# ============================================
# Database Configuration (DEMO: SQLite)
# ============================================
# DEMO PROTOTYPE: Using SQLite for simplicity (no server setup required)
# For production, use PostgreSQL
DATABASE_URL=sqlite:///./tulapramaan_demo.db

# PostgreSQL settings (for reference, not used in demo)
# DATABASE_URL=postgresql://user:password@localhost:5432/tulapramaan
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tulapramaan
# DB_USER=your_db_user
# DB_PASSWORD=your_secure_password

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_ECHO=false  # Set to true for SQL query logging

# ============================================
# Security & Authentication
# ============================================
SECRET_KEY=your-secret-key-change-this-in-production-min-32-chars
JWT_SECRET_KEY=your-jwt-secret-key-change-this-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# ============================================
# Rulepack Configuration
# ============================================
RULEPACK_DIR=./rulepacks
DEFAULT_RULEPACK_VERSION=R76-1:2006

# Rulepack Cache Settings
RULEPACK_CACHE_ENABLED=true
RULEPACK_AUTO_RELOAD=false  # Set to true in development for hot-reloading

# ============================================
# AI/LLM Services (for OCR & Explanations)
# ============================================
# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# Vision/OCR Service
VISION_SERVICE_ENABLED=true
VISION_MODEL=gpt-4-vision-preview
VISION_MAX_IMAGE_SIZE=4  # MB

# ============================================
# File Storage
# ============================================
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE=10485760  # 10MB in bytes
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp
ALLOWED_DOCUMENT_TYPES=application/pdf,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document

# ============================================
# Testing & Development
# ============================================
# Test Database (separate from production)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/tulapramaan_test

# Pytest Configuration
PYTEST_WORKERS=auto
HYPOTHESIS_MAX_EXAMPLES=1000

# ============================================
# Logging
# ============================================
LOG_LEVEL=INFO  # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json  # json | text
LOG_FILE=./logs/app.log
LOG_ROTATION=daily  # daily | size
LOG_RETENTION_DAYS=30

# ============================================
# Audit Trail & Compliance
# ============================================
AUDIT_LOG_ENABLED=true
AUDIT_LOG_HASH_CHAIN=true
AUDIT_LOG_TABLE=audit_trail

# ============================================
# Redis (Optional - for caching & sessions)
# ============================================
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_CACHE_TTL=3600  # seconds

# ============================================
# Email Notifications (Optional)
# ============================================
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-email-password
SMTP_FROM=noreply@tulapramaan.com
SMTP_TLS=true

# ============================================
# Report Generation
# ============================================
REPORT_OUTPUT_DIR=./reports
REPORT_TEMPLATE_DIR=./templates/reports
REPORT_LOGO_PATH=./assets/logo.png
REPORT_FORMATS=pdf,docx  # Comma-separated

# PDF Generation
WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf  # Path to wkhtmltopdf binary

# ============================================
# Performance & Rate Limiting
# ============================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Request Timeout
REQUEST_TIMEOUT_SECONDS=30

# ============================================
# Monitoring & Metrics (Optional)
# ============================================
SENTRY_DSN=  # Add Sentry DSN for error tracking
SENTRY_ENVIRONMENT=development

# Prometheus Metrics
METRICS_ENABLED=false
METRICS_PORT=9090

# ============================================
# Feature Flags
# ============================================
FEATURE_OCR_ENABLED=true
FEATURE_LIVE_MPE_FEEDBACK=true
FEATURE_MULTI_RANGE_SUPPORT=true
FEATURE_BATCH_REPETITIVE_TESTS=true
FEATURE_ENVIRONMENT_AUTO_PROPAGATION=true

# ============================================
# Frontend Configuration (for reference)
# ============================================
FRONTEND_URL=http://localhost:3000
VITE_API_BASE_URL=http://localhost:8000/api/v1

# ============================================
# Decimal Precision Settings
# ============================================
DECIMAL_PRECISION=6  # Number of decimal places for calculations
MPE_ROUNDING_MODE=ROUND_HALF_UP  # Python Decimal rounding mode

# ============================================
# Session Management
# ============================================
SESSION_TIMEOUT_MINUTES=120
SESSION_STORAGE=database  # database | redis | memory

# ============================================
# Development Tools
# ============================================
# Auto-reload on code changes (development only)
RELOAD=true

# API Documentation
DOCS_ENABLED=true
DOCS_URL=/docs
REDOC_URL=/redoc

# ============================================
# Backup Configuration
# ============================================
BACKUP_ENABLED=true
BACKUP_DIR=./backups
BACKUP_SCHEDULE=daily  # daily | weekly
BACKUP_RETENTION_DAYS=30

# ============================================
# Internationalization (Future)
# ============================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en

# ============================================
# NOTES FOR DEPLOYMENT
# ============================================
# 1. NEVER commit .env file to version control
# 2. Use strong, randomly generated SECRET_KEY and JWT_SECRET_KEY in production
# 3. Change all default passwords
# 4. Set DEBUG=false in production
# 5. Use environment-specific database URLs
# 6. Configure CORS_ORIGINS to match your production domain
# 7. Enable HTTPS in production
# 8. Set appropriate LOG_LEVEL (INFO or WARNING in production)
# 9. Configure backup strategy for production data
# 10. Set up monitoring and error tracking (Sentry, etc.)
